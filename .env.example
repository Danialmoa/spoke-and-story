# Free key: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
# Optional, recommended: Backboard runs Gemma 4 in ~2 s instead of ~30 s (https://app.backboard.io, Settings > API Keys).
# Empty = Google AI Studio only. Google stays the fallback when Backboard fails.
BACKBOARD_API_KEY=
BACKBOARD_MODEL=google/gemma-4-26b-a4b-it
# Google AI Studio key (free tier serves Gemma): https://aistudio.google.com/apikey
GEMINI_API_KEY=
LLM_MODEL=gemma-4-26b-a4b-it
# Optional: Sentry tracing (Settings > Projects > your project > Client Keys (DSN)). Empty = off.
SENTRY_DSN=
