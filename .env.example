# Free key: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
# Optional, recommended: Backboard runs Gemma 4 in ~2 s instead of ~30 s (https://app.backboard.io, Settings > API Keys).
# Empty = Google AI Studio only. Google stays the fallback when Backboard fails.
BACKBOARD_API_KEY=
BACKBOARD_MODEL=google/gemma-4-26b-a4b-it
# Google AI Studio key (free tier serves Gemma): https://aistudio.google.com/apikey
GEMINI_API_KEY=
LLM_MODEL=gemma-4-26b-a4b-it
# Optional: Sentry tracing (Settings > Projects > your project > Client Keys (DSN)). Empty = off.
SENTRY_DSN=
# Optional, recommended: ElevenLabs is the guide's fast voice (~1 s a line). Empty = Kokoro in the browser only.
# A restricted key with only "Text to Speech" access is enough (https://elevenlabs.io/app/settings/api-keys).
# Also give the key a "Credit quota" there: the caps below live in memory and restart with every deploy.
ELEVENLABS_API_KEY=
# Default: George (JBFqnCBsd6RMkjVDRZzb), a warm storyteller. Copy another ID from My Voices to change it.
ELEVENLABS_VOICE_ID=
# Characters a day for everyone together (default 10000); after that the page uses Kokoro.
ELEVENLABS_DAILY_CHARS=
